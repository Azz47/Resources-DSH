# ---- DSH 工作区提交策略：只提交文档与脚本 ----
# 大体积/归档目录（不入库）
_archive/
_backup/
.kg-scratch/
corpus/
dsh-image-gen/
demo/
# 依赖与构建产物
node_modules/
dist/
build/
*.log
# 环境文件：一律排除，防止以后误填 token
.env
.env.*
!.env.example
# 各类备份快照
*.bak-*
*.bak
*~
# 系统与缓存
.DS_Store
Thumbs.db
__pycache__/
*.pyc
# DSH 插件运行期产物（截图/缓存，非源码）
.dsh-vision-router/
.dsh-imagegen/
.mindmaps/

# 诊断用的原始会话/日志快照（体积大且非知识资产）
*.jsonl
_probe/_*

# 大体积中间产物与截图（png/jpeg 多为调试截图，非文档资产）
*.png
*.jpeg
*.jpg
*.tgz
_probe/upstream-trees/
_probe/corpus_sheets/
generate/image/

# 内嵌图片占比 98.5% 的素材型大 HTML（非文档）
_specs/layout-atlas.html

decks/ 目录下的成品课件（.pptx）**允许入库**——体积小（单个 <5 MB），需版本可追溯

# _probe 下的 Office 冒烟测试产物（调试残留，非交付）
_probe/**/*.docx
_probe/**/*.pptx
_probe/**/*.xlsx
_probe/**/*.pdf

